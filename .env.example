# ════════════════════════════════════════════════
# SUKA / MESA — Environment Variables
# FILE LOCATION: backend/.env   ← put it here
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values below
#   3. Never commit .env to git (it's in .gitignore)
# ════════════════════════════════════════════════

# ── Database ─────────────────────────────────────
# Option A — Single connection string (Railway gives you this automatically)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/suka

# Option B — Individual values (use if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=suka
# DB_USER=postgres
# DB_PASSWORD=yourpassword

# ── Server ───────────────────────────────────────
PORT=3000

# Dashboard auth secret — CHANGE THIS in Railway environment variables
# Used to sign and verify dashboard session tokens
# Generate a strong random string: openssl rand -hex 32
MESA_SECRET=change-this-to-a-long-random-string-in-production
